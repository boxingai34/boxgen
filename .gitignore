# =====================================================================
# YANG TIDAK BOLEH NAIK KE GITHUB
#
# Kalau satu baris di bawah ini terhapus, rahasiamu ikut terbit ke
# internet. GitHub menyimpan riwayat, jadi menghapusnya belakangan tidak
# benar-benar menghilangkannya — kunci yang terlanjur naik harus dicabut
# dan dibuat ulang, bukan sekadar dihapus dari berkas.
# =====================================================================

# Kunci API Gemini, password database, SYNC_KEY.
config.local.php

# Hasil ekspor database. Isinya SELURUH data, termasuk tabel users
# beserta hash password adminmu.
database/export/

# Gambar pratinjau hasil unduhan. Terisi sendiri, tidak perlu disimpan.
assets/thumbs/

# Catatan jalannya deploy di server.
tools/deploy.log

# Sampah editor & sistem
.vscode/
.idea/
Thumbs.db
desktop.ini
*.bak
*.swp
*~

# Daftar sertifikat khusus komputer ini (lihat CA_BUNDLE di config.php).
# Isinya root lokal seperti antivirus atau jaringan kantor — bukan urusan proyek.
cacert.local.pem

# Catatan aplikasi lama, di akar repo saja. Tanpa garis miring di
# depan, pola ini ikut menelan v2/storage/logs/ — dan foldernya jadi
# tidak ikut waktu repo ini diklon ke hosting.
/logs/
