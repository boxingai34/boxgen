# ---------------------------------------------------------------------
# Pengaman dasar Apache.
# Berlaku di XAMPP maupun di hosting (InfinityFree memakai Apache juga).
# ---------------------------------------------------------------------

# Jangan tampilkan isi folder kalau tidak ada index
Options -Indexes

# File rahasia tidak boleh diakses lewat browser sama sekali
# (termasuk .env milik Laravel di v2/ dan variannya)
<FilesMatch "^(config\.local\.php|config\.local\.example\.php|\.env(\..*)?)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Dokumentasi, SQL, dan file cadangan jangan bisa diunduh orang
# (cadangan bernomor seperti landing.json.bak3 ikut tertangkap)
<FilesMatch "\.(md|sql|log|bak[0-9]*|ini|json|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------
# Dua aplikasi di satu domain.
#
#   /               halaman depan publik   -> v2/public (Laravel)
#   /generator/...  alat prompt baru       -> v2/public (Laravel)
#   /index.php, /reverse.php, /admin/ ...  aplikasi lama, tetap di sini
#
# Pola di RewriteRule dicocokkan RELATIF terhadap folder berkas ini, jadi
# aturannya sama saja di akar domain maupun di sub-folder. Laravel di
# v2/public membaca REQUEST_URI apa adanya, jadi aturan ini hanya benar
# kalau folder ini dipasang sebagai AKAR domain (domain.com/) —
# persis seperti di hosting. Di komputer sendiri pakai `php artisan
# serve` (lihat v2/README.md).
#
# Kalau folder v2 belum ada (klon lama yang belum di-pull), semua aturan
# dilewati dan aplikasi lama bekerja seperti sebelumnya.
# ---------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Isi v2 selain public/ (storage, vendor, .env, sesi) tidak boleh
    # diminta langsung.
    RewriteRule ^v2/(?!public/) - [F,L]

    # Alamat /v2/public/... tidak boleh diketik langsung: isinya
    # halaman yang sama di alamat kedua. Dulu yang dibaca
    # REDIRECT_STATUS, tapi di hosting nilainya ternyata tidak selalu
    # kosong dan penjagaan ini diam saja. Yang dibaca sekarang baris
    # permintaan aslinya — baris itu tetap seperti yang diketik
    # pengunjung walau aturan di bawah meneruskannya ke v2/public.
    RewriteCond %{THE_REQUEST} \s/+v2/public[/?\s] [NC]
    RewriteRule ^ - [F,L]

    RewriteCond %{DOCUMENT_ROOT}/v2/public/index.php -f
    RewriteRule ^(build|img|uploads|fonts)/(.+)$ v2/public/$1/$2 [L]

    # Berkas yang diminta browser dari akar domain. Ikonnya PNG —
    # favicon.ico tidak pernah dibuat, jadi aturan lama berakhir 404 di
    # tiap tab. robots.txt dan site.webmanifest ikut di sini karena
    # keduanya juga tinggal di v2/public tapi dipanggil dari akar.
    RewriteCond %{DOCUMENT_ROOT}/v2/public/index.php -f
    RewriteRule ^favicon\.ico$ v2/public/img/favicon.png [L]

    RewriteCond %{DOCUMENT_ROOT}/v2/public/index.php -f
    RewriteRule ^(robots\.txt|site\.webmanifest)$ v2/public/$1 [L]

    RewriteCond %{DOCUMENT_ROOT}/v2/public/index.php -f
    RewriteRule ^$ v2/public/index.php [L]

    RewriteCond %{DOCUMENT_ROOT}/v2/public/index.php -f
    RewriteRule ^generator(/.*)?$ v2/public/index.php [L]
</IfModule>

# Sembunyikan versi PHP di header
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
