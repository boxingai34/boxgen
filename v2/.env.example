# Setelan v2 (Laravel). Salin jadi .env, lalu isi.
#
# Waktu naik ke hosting yang benar-benar perlu diisi cuma tiga: APP_KEY
# (dibuat `php artisan key:generate`), APP_URL, dan DB_*. Sisanya sudah
# pas untuk hosting bersama. Di komputer sendiri: APP_ENV=local,
# APP_DEBUG=true, APP_URL=http://localhost:8000.
#
# Satu hal yang gampang menghancurkan aplikasi lama: JANGAN jalankan
# `php artisan migrate`. Tabel `users` itu milik aplikasi lama dan dipakai
# berdua; migrasi bawaan Laravel akan mencoba membuatnya lagi. Sesi,
# cache, dan antrean di bawah sengaja memakai berkas dan `sync` supaya
# tidak butuh tabel sama sekali.

APP_NAME=BoxinGenerated
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://boxingenerated.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# warning, bukan error: kegagalan mengambil video/galeri/pos dicatat di
# tingkat ini, dan itulah yang dibaca kalau ada bagian halaman depan yang
# tiba-tiba kosong.
LOG_LEVEL=warning

# Database yang sama dengan aplikasi lama — lihat config.local.php.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=boxgen
DB_USERNAME=
DB_PASSWORD=

# Berkas dan sync, bukan tabel (lihat catatan di atas).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Alamat aplikasi lama; dipakai menu "Alat lain" untuk menaut ke sana.
LEGACY_URL=https://boxingenerated.com

MAIL_MAILER=log
MAIL_FROM_ADDRESS="halo@boxingenerated.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
